# ==============================================================================
# PashuSuraksha - Master Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# Format: Variable Name | Description | Source / How to Obtain | Required Status
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# PORT: Local backend listening port (default: 5000)
PORT=5000

# NODE_ENV: Application environment ('development' | 'production')
NODE_ENV=development

# FRONTEND_URL: Public URL of the frontend application
# Local: http://localhost:5173 | Prod: https://pashusuraksha.vercel.app
FRONTEND_URL=http://localhost:5173

# ALLOWED_ORIGINS: Comma-separated list of origins permitted for CORS & WebSockets
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE (Section 16.B & 16.C)
# ------------------------------------------------------------------------------
# DATABASE_URL: Database connection string.
# Local Dev: sqlite://./pashusuraksha.sqlite
# Production: postgresql://username:password@ep-sample-123.us-east-2.aws.neon.tech/neondb?sslmode=require
# Where to get: Neon (https://neon.tech) or Supabase (https://supabase.com)
DATABASE_URL=sqlite://./pashusuraksha.sqlite

# STORAGE_MODE: Media storage driver ('local' | 'cloud')
# Local: stores in ./uploads/ | Cloud: Supabase Storage / Cloudinary
STORAGE_MODE=local

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret encryption key for signing JSON Web Tokens
# Generate via: node scripts/generate_secrets.js
JWT_SECRET=pashu_suraksha_super_secret_jwt_key_2026_production_grade_random_bytes

# ADMIN_EMAIL: Default administrative master account email
ADMIN_EMAIL=admin@pashusuraksha.gov.in

# ADMIN_PASSWORD: Default administrative password
ADMIN_PASSWORD=PashuAdmin@2026

# OTP_MODE: Authentication OTP verification mode ('mock' | 'sms')
# 'mock': logs OTP 123456 to console | 'sms': triggers real carrier gateway
OTP_MODE=mock

# DEMO_MODE: Pre-seeds sample cases, history, and test records ('true' | 'false')
DEMO_MODE=true

# ------------------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE & VISION SERVICES (Section 4.C & Section 7)
# ------------------------------------------------------------------------------
# AI_SERVICE: AI Provider engine ('gemini' | 'mock')
# 'gemini': Google Gemini Multimodal API | 'mock': Local rule-based fallback
AI_SERVICE=mock

# AI_API_KEY: API Key for AI service.
# Where to get: Google AI Studio (https://aistudio.google.com/)
# Optional: If missing, app gracefully falls back to local knowledge base & rule engine
AI_API_KEY=

# ------------------------------------------------------------------------------
# 5. GEOLOCATION & EXTERNAL PLACES (Section 4.D)
# ------------------------------------------------------------------------------
# GOOGLE_PLACES_KEY: Google Cloud API Key for Places & Geocoding
# Where to get: Google Cloud Console (https://console.cloud.google.com/)
# Optional: If omitted, app uses verified district centroids and Leaflet OpenStreetMap
GOOGLE_PLACES_KEY=

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS & ALERTS (Section 4.H)
# ------------------------------------------------------------------------------
# VAPID_PUBLIC_KEY: Public key for Web Push notifications (RFC 8292)
# Generate via: node scripts/generate_secrets.js
VAPID_PUBLIC_KEY=BNxK_sample_public_key_pashusuraksha_push_notification_client_demo

# VAPID_PRIVATE_KEY: Private key for Web Push notifications
VAPID_PRIVATE_KEY=sample_private_vapid_key_not_for_production

# ------------------------------------------------------------------------------
# 7. TELE-CONSULTATION & WEBRTC (Section 4.E)
# ------------------------------------------------------------------------------
# JITSI_BASE_URL: Base domain for Jitsi Meet video consultation rooms
# Default: https://meet.jit.si
JITSI_BASE_URL=https://meet.jit.si

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT-SIDE VARIABLES (Vite prefix VITE_)
# ------------------------------------------------------------------------------
# VITE_API_URL: Target backend URL used by frontend client
VITE_API_URL=http://localhost:5000
